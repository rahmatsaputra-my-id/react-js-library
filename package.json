{
  "name": "@rahmatsaputra-my-id/react-js-library",
  "version": "0.0.27",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "private": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist .turbo .rpt2_cache && npm cache clean --force",
    "build": "npm run clean && rollup -c",
    "release": "standard-version",
    "build:publish": "npm run build && npm publish",
    "ci:release": "npx standard-version && git push --follow-tags origin master && npm run build && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/rahmatsaputra-my-id/react-js-library.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@zxing/library": "^0.21.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "rollup": "^2.79.1",
    "rollup-plugin-delete": "^2.0.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^4.9.5",
    "standard-version": "^9.5.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
